# LiteLLM reads provider keys from the environment.
# Set whichever provider(s) you use with --model / the GUI default.
# Set this to true to reject chat requests for any model but openrouter/free.
KINDRED_REQUIRE_OPENROUTER_FREE_MODEL=false

# Comma-separated Google accounts that chat with chatgpt/gpt-6.1-sol via the server's ChatGPT login.
# One-time server login: python -c "from litellm.llms.chatgpt.authenticator import Authenticator; Authenticator().get_access_token()"
KINDRED_CODEX_ALLOWED_EMAILS=
# CHATGPT_TOKEN_DIR=~/.config/litellm/chatgpt

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Used by Jev-backed math detection.
OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# OpenLLMetry / Traceloop tracing (optional). When TRACELOOP_API_KEY or
# TRACELOOP_BASE_URL is set, kindred instruments LiteLLM.
TRACELOOP_API_KEY=
# TRACELOOP_BASE_URL=https://api.traceloop.com
# TRACELOOP_TRACING_ENABLED=true
# TRACELOOP_TRACE_CONTENT=true
# TRACELOOP_DISABLE_BATCH=true
